#!/usr/bin/env bash
# DICFO git guard: blocks personal data from ever being committed.
# Enabled by `python -m dicfo secure init` (git config core.hooksPath scripts/hooks).
set -euo pipefail
fail=0
while IFS= read -r f; do
  case "$f" in
    profiles/example-*) ;;
    profiles/*|.env|*.enc|reports/*|snapshots/*|*-ledger.csv|*.key|*.pem)
      echo "BLOCKED: $f is personal/secret data and must not be committed."; fail=1 ;;
  esac
done < <(git diff --cached --name-only --diff-filter=ACM)

# Content scan of what is being added (PAN, Aadhaar, SSN, private keys, obvious secrets)
added=$(git diff --cached -U0 --diff-filter=ACM -- . ':(exclude)tests/*' ':(exclude)dicfo/security.py' ':(exclude)scripts/hooks/*' | grep '^+' | grep -v '^+++' || true)
if echo "$added" | grep -Eq '\b[A-Z]{5}[0-9]{4}[A-Z]\b'; then echo "BLOCKED: looks like a PAN number."; fail=1; fi
if echo "$added" | grep -Eq '\b[2-9][0-9]{3}[ -]?[0-9]{4}[ -]?[0-9]{4}\b'; then echo "BLOCKED: looks like an Aadhaar number."; fail=1; fi
if echo "$added" | grep -Eq '\b[0-9]{3}-[0-9]{2}-[0-9]{4}\b'; then echo "BLOCKED: looks like a US SSN."; fail=1; fi
if echo "$added" | grep -Eq 'BEGIN (RSA |EC |OPENSSH )?PRIVATE KEY'; then echo "BLOCKED: private key."; fail=1; fi
if echo "$added" | grep -Eiq '(DICFO_KEY|SMTP_PASS|AUTH_TOKEN|BOT_TOKEN|BRIDGE_TOKEN|ACCOUNT_SID|APIKEY|PASSWORD)\s*=\s*[^[:space:]]{6,}' ; then
  echo "BLOCKED: looks like a secret value. Secrets belong in .env (git-ignored)."; fail=1; fi
if echo "$added" | grep -Eq '[0-9]{8,10}:[A-Za-z0-9_-]{30,}'; then echo "BLOCKED: looks like a Telegram bot token."; fail=1; fi
if [ $fail -ne 0 ]; then
  echo "Commit stopped by the DICFO guard. Remove the files/values above (git restore --staged <file>)."
  exit 1
fi
