<?xml version="1.0" encoding="UTF-8"?>
<!-- macOS: copy to ~/Library/LaunchAgents/, edit the two paths, then:
     launchctl load ~/Library/LaunchAgents/com.dicfo.telegram.plist -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.dicfo.telegram</string>
  <key>ProgramArguments</key><array>
    <string>/Users/YOU/Documents/AI-CFO/.venv/bin/python</string><string>-m</string><string>dicfo</string>
    <string>telegram-listen</string><string>--profile</string><string>dad</string></array>
  <key>WorkingDirectory</key><string>/Users/YOU/Documents/AI-CFO</string>
  <key>RunAtLoad</key><true/><key>KeepAlive</key><true/>
  <key>StandardErrorPath</key><string>/tmp/dicfo-telegram.log</string>
</dict></plist>
