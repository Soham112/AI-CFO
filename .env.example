# Copy to .env and fill in. .env is git-ignored.
DICFO_PROFILE=dad

# Email (Gmail: turn on 2-step verification, then create an App Password)
DICFO_SMTP_HOST=smtp.gmail.com
DICFO_SMTP_PORT=587
DICFO_SMTP_USER=you@gmail.com
DICFO_SMTP_PASS=app-password-here
DICFO_EMAIL_TO=dad@example.com

# WhatsApp option A: CallMeBot (free, personal use). Send "I allow callmebot to send me messages"
# to the number listed on callmebot.com/blog/free-api-whatsapp-messages/ to get an API key.
CALLMEBOT_PHONE=+919800000000
CALLMEBOT_APIKEY=123456

# WhatsApp option B: Twilio (paid, more reliable)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_TO=whatsapp:+919800000000
