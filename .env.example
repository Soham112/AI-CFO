# Copy to .env and fill in. .env is git-ignored.
DICFO_PROFILE=dad

# Email (Gmail: turn on 2-step verification, then create an App Password)
DICFO_SMTP_HOST=smtp.gmail.com
DICFO_SMTP_PORT=587
DICFO_SMTP_USER=you@gmail.com
DICFO_SMTP_PASS=app-password-here
DICFO_EMAIL_TO=dad@example.com

# Telegram (recommended: free, official API). 1) In Telegram, message @BotFather, send /newbot,
# copy the token. 2) Open your new bot and press Start. 3) Run: python -m dicfo telegram-id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_DETAIL_CHAT_ID=          # optional: gets the detailed brief (e.g. Soh)
DICFO_SHOW_AMOUNTS=1              # 0 hides suggested amounts in Telegram

# WhatsApp via Twilio (official Meta provider, paid; free-form messages only arrive within
# 24 hours of your last message to the Twilio number)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_TO=whatsapp:+919800000000

# WhatsApp via the local whatsapp-mcp bridge (unofficial; see docs/MESSAGING.md before using)
DICFO_WA_ALLOWED=
DICFO_WA_BRIDGE_TOKEN=
DICFO_WA_BRIDGE_URL=http://127.0.0.1:8080/api/send
DICFO_WA_DAILY_TO=
